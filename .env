# Malware Analysis Pipeline - Environment Configuration
# Copy this file to .env and fill in your API keys

# Hybrid Analysis (AnyRun) API
# Get key from: https://hybrid-analysis.com/api
HYBRID_ANALYSIS_API_KEY=su3aef10519c5b113cqcmxe012af9bb04sctdp1b757bfa5cmuyfoj8560d918b1

# VirusTotal API v3
# Get key from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=2812fb192268bb13c706701b531d07f3f2049457e5769bfcbe2f5c7bbee34afc

# API Configuration
# Timeout for API requests (seconds)
API_TIMEOUT=30

# Number of parallel sandbox submissions
MAX_WORKERS=3

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Output Configuration
OUTPUT_DIR=artifacts
SAVE_RAW_RESPONSES=true
# YARA Configuration
# Path to YARA rules directory (absolute path or relative to project root)
# Examples:
#   YARA_RULES_PATH=yara_rules
#   YARA_RULES_PATH=C:\yara-rules
#   YARA_RULES_PATH=/opt/yara-rules
# If set, YARA scanning will be enabled for IOC extraction
YARA_RULES_PATH=yara_rules