# Malware Analysis Pipeline - Environment Configuration
# Copy this file to .env and fill in your API keys

# Hybrid Analysis (AnyRun) API
# Get key from: https://hybrid-analysis.com/api
HYBRID_ANALYSIS_API_KEY=your_hybrid_analysis_api_key_here

# VirusTotal API v3
# Get key from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# API Configuration
# Timeout for API requests (seconds)
API_TIMEOUT=30

# Number of parallel sandbox submissions
MAX_WORKERS=3

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Output Configuration
OUTPUT_DIR=artifacts
SAVE_RAW_RESPONSES=true
